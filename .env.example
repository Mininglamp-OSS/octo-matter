# Octo Matter — environment variables
# Copy to .env and fill in values for local development.

APP_ENV=dev
MYSQL_DSN=matter:matter@tcp(127.0.0.1:3306)/octo_matter?charset=utf8mb4&parseTime=true
OCTO_IM_URL=http://127.0.0.1:8090
NOTIFY_INTERNAL_TOKEN=
SERVER_PORT=8080
LLM_API_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6
OCTO_LLM_PROVIDER=compat
LLM_TIMEOUT=30
